  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/swagger-ui": "0.6.1",
    "@hono/zod-openapi": "1.6.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.5",
    "pg": "8.16.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/pg": "8.15.5",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
